{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "FIREBASE_SDK_VERSION": "12.18.0"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "environment": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "image": "latest"
      },
      "env": {
        "FIREBASE_SDK_VERSION": "12.18.0",
        "EXPO_PUBLIC_USE_CLOUD_AI": "true",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "simulator": {
      "extends": "production",
      "environment": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "ios": {
        "simulator": true,
        "image": "latest"
      },
      "env": {
        "FIREBASE_SDK_VERSION": "12.18.0",
        "EXPO_PUBLIC_EXPO_GO": "0",
        "EXPO_PUBLIC_APP_CHECK_ENABLED": "true",
        "EXPO_PUBLIC_USE_CLOUD_AI": "true",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_APP_CHECK_SIMULATOR_DEBUG": "simulator"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      },
      "env": {
        "FIREBASE_SDK_VERSION": "12.18.0",
        "EXPO_PUBLIC_EXPO_GO": "0",
        "EXPO_PUBLIC_APP_CHECK_ENABLED": "true",
        "EXPO_PUBLIC_USE_CLOUD_AI": "true",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6820059284",
        "appleTeamId": "833CYAZ8XT"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
