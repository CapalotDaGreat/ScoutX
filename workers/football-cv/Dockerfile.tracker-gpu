# Player-tracking worker (scoutx_tracker + /v3 endpoints) for a CUDA GPU (e.g. Cloud Run + NVIDIA L4).
# NOT DEPLOYED, NOT BUILT and NOT BENCHMARKED from this repository (5.1: no Docker daemon and no
# registry access in the development environment): build it on a GPU host, then run
#   docker run --gpus all -v /path/to/video:/data <image> python3.11 bench/pipeline_benchmark.py \
#       --video /data/match.mp4 --number 20 --kit orange --out /tmp/bench.json --price-per-hour <your rate>
# before quoting any GPU runtime or cost.
#
# The original Dockerfile only packaged the 2.x frame-analysis backends; tracking v3 needs the
# scoutx_tracker engine, its requirements and the hash-pinned YOLOX weights (Apache-2.0).
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ARG WORKER_VERSION=football-cv/5.1.0-dev
LABEL org.opencontainers.image.title="pitchproof-football-cv-tracker-gpu" \
      org.opencontainers.image.version="${WORKER_VERSION}" \
      org.opencontainers.image.licenses="proprietary; YOLOX weights Apache-2.0; EasyOCR Apache-2.0; docTR Apache-2.0"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/opt/models \
    EASYOCR_MODULE_PATH=/opt/models/easyocr \
    DOCTR_CACHE_DIR=/opt/models/doctr \
    SCOUTX_WEIGHTS_DIR=/opt/models/yolox \
    SCOUTX_DETECTOR=yolox_s \
    SCOUTX_BACKEND=auto \
    SCOUTX_DISCOVERY_DET=416 \
    SCOUTX_DECODER=auto \
    SCOUTX_HWACCEL=cuda \
    WORKER_VERSION=${WORKER_VERSION} \
    PORT=8080

# 5.1 fix (static review, not built here): Ubuntu 22.04's python3-pip belongs to the system
# Python 3.10, so `python3.11 -m pip` failed; a 3.11 virtual environment provides its own pip.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3.11 python3.11-venv ffmpeg libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && python3.11 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

WORKDIR /srv
COPY requirements.txt requirements-tracker.txt ./
RUN python3.11 -m pip install --no-cache-dir -r requirements.txt -r requirements-tracker.txt

COPY scoutx_tracker ./scoutx_tracker
COPY app ./app
COPY bench ./bench

# Weights are fetched once at build time (hash-checked) so no request downloads models; the
# persistent worker then keeps detector and OCR loaded between calls.
RUN python3.11 -c "from scoutx_tracker.extract import weights_path; weights_path('yolox_s')" \
    && python3.11 -c "from scoutx_tracker.ocr import NumberReader; NumberReader()" \
    && chmod -R a+rX /opt/models

RUN useradd --uid 10001 --no-create-home worker
USER worker

# Liveness only (models are loaded on first request and then kept); Cloud Run uses its own probe.
# (5.1: no curl in the image - the check uses Python's standard library)
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s \
    CMD python3.11 -c "import os, urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"PORT\", \"8080\")}/healthz', timeout=4)" || exit 1

# One request at a time per instance (a GPU is not shared between concurrent segments);
# TRACKING_V3_ENABLED and TRACKING_ARTIFACT_ROOT are set by the deployment, never baked in.
CMD ["sh", "-c", "python3.11 -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --workers 1"]
