{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PitchProof real-footage annotation",
  "description": "Made by a person watching the video with the documented permission of the player (and guardian for minors). Store annotations and footage outside the repository; never commit real footage.",
  "type": "object",
  "required": ["videoId", "durationSec", "targetJersey", "annotator", "difficulty", "visibleIntervals", "targetBoxes", "events"],
  "additionalProperties": false,
  "properties": {
    "videoId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" },
    "durationSec": { "type": "number", "exclusiveMinimum": 0 },
    "targetJersey": { "type": "string", "pattern": "^[0-9]{1,3}$" },
    "kitPrimaryColor": { "type": "string", "maxLength": 40 },
    "kitSecondaryColor": { "type": "string", "maxLength": 40 },
    "annotator": { "type": "string", "description": "Pseudonymous annotator id, never a name.", "pattern": "^[A-Za-z0-9_-]{1,40}$" },
    "annotatedAt": { "type": "string", "format": "date" },
    "conditions": {
      "type": "object",
      "description": "Recording conditions.",
      "properties": {
        "camera": { "enum": ["tripod_wide", "handheld", "drone", "broadcast", "phone_sideline"] },
        "light": { "enum": ["day", "floodlight", "dusk", "indoor"] },
        "pitch": { "enum": ["grass", "artificial", "indoor", "other"] },
        "level": { "enum": ["youth", "amateur", "semi_pro", "pro"] }
      },
      "additionalProperties": false
    },
    "difficulty": {
      "description": "Every difficult condition that occurs in the video. Results are reported per tag.",
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["occlusion", "camera_movement", "low_light", "similar_kits", "identical_numbers", "substitution", "off_camera_periods", "re_entry"] }
    },
    "visibleIntervals": {
      "description": "Seconds where the target player is visible on camera.",
      "type": "array",
      "items": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 }
    },
    "onPitchIntervals": {
      "description": "Seconds where the target was on the pitch (visible or not). Defaults to the whole video. Substitutions end and start intervals.",
      "type": "array",
      "items": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 }
    },
    "targetBoxes": {
      "description": "Keyframes (at least one every 5 s of footage) with the target's box in pixels, or null when the target is not visible. Used for identity accuracy, switches and continuity.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["timeSec", "box"],
        "additionalProperties": false,
        "properties": {
          "timeSec": { "type": "number", "minimum": 0 },
          "box": {
            "oneOf": [
              { "type": "null" },
              { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
            ]
          }
        }
      }
    },
    "events": {
      "description": "Actions by the target player only. Scored only once the worker has a complete event stage.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "timeSec"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["shot", "pass", "dribble", "tackle", "save", "duel", "other"] },
          "timeSec": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
