{
  "name": "scoutx",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/start-expo.mjs --expo-go --online",
    "start:dev-client": "node scripts/start-expo.mjs --dev-client --online",
    "start:offline": "node scripts/start-expo.mjs --expo-go",
    "start:online": "node scripts/start-expo.mjs --expo-go --online",
    "start:localhost": "node scripts/start-expo.mjs --expo-go --localhost --online",
    "start:expo-go": "node scripts/start-expo.mjs --expo-go --online",
    "start:expo-go:tunnel": "node scripts/start-expo.mjs --expo-go --tunnel --online",
    "start:tunnel": "node scripts/start-expo.mjs --expo-go --tunnel --online",
    "start:clean": "npx --yes kill-port 8081 8082 && node scripts/start-expo.mjs --expo-go --online -- --clear",
    "sync-dev-env": "node scripts/sync-dev-env.mjs",
    "export-ca": "powershell -ExecutionPolicy Bypass -File ./scripts/export-avg-ca.ps1",
    "expo:login": "node scripts/expo-login.mjs",
    "expo:whoami": "node scripts/expo-whoami.mjs",
    "android": "node scripts/start-expo.mjs --android --online",
    "ios": "node scripts/start-expo.mjs --ios --online",
    "web": "node scripts/start-expo.mjs --expo-go --web --online",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test:unit": "node --import ./tests/unit/support/register.mjs --test \"tests/unit/*.test.ts\"",
    "test:rules": "npm run build --prefix functions && firebase emulators:exec --only firestore,storage --project demo-scoutx \"node --import ./tests/unit/support/register.mjs --test --test-concurrency=1 tests/rules/firestore.rules.test.mjs tests/rules/storage.rules.test.mjs tests/rules/accountDeletion.test.mjs tests/rules/aiCallables.test.mjs tests/rules/pushChain.test.mjs tests/rules/requestCenter.test.mjs tests/rules/reelExport.test.mjs tests/rules/moderation.test.mjs tests/rules/uploads.test.mjs tests/rules/analysisPipeline.test.mjs tests/rules/entitlements.test.mjs\"",
    "legal:build": "node scripts/build-legal.mjs",
    "legal:check": "node scripts/build-legal.mjs --check",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:web": "node scripts/run-e2e.mjs --project=web-desktop --project=web-mobile",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:ui": "playwright test --ui",
    "agentation:apply": "re-agentation-apply",
    "test:e2e:emulators": "npm run build --prefix functions && node scripts/run-e2e-emulators.mjs",
    "seed:emulators": "node scripts/seed-emulators.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/app-check": "^25.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.103.2",
    "clsx": "^2.1.1",
    "expo": "~57.0.26",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.18",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-print": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "expo-video-thumbnails": "~57.0.2",
    "firebase": "^12.15.0",
    "i18next": "^26.3.4",
    "lucide-react-native": "^1.47.0",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.86.3",
    "react-native-css-interop": "^0.2.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.11.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.61.1",
    "@re-agentation/mcp": "^0.2.1",
    "@re-agentation/metro": "^0.2.1",
    "@re-agentation/probe": "^0.2.1",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.4",
    "@typescript-eslint/parser": "^8.62.1",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
