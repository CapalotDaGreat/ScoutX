EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# AI (optional — never commit real keys; use .env locally)
# Provider: "mock" | "openrouter" (defaults to openrouter when key is set)
EXPO_PUBLIC_AI_PROVIDER=
EXPO_PUBLIC_OPENROUTER_API_KEY=
EXPO_PUBLIC_OPENROUTER_MODEL=google/gemma-2-9b-it:free
EXPO_PUBLIC_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Production: force Cloud Functions AI (set in eas.json production profile)
EXPO_PUBLIC_USE_CLOUD_AI=

# Launch readiness
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ADMIN_USER_IDS=

# Store listing metadata lives in store/listing.json
# EAS submit credentials: configure eas.json submit.production section
