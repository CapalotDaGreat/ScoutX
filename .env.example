EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# AI runs only in Cloud Functions (secret OPENROUTER_API_KEY, never in the app).
# Server model overrides must be on the allowlist in functions/src/ai/providerConfig.ts:
# OPENROUTER_MODEL=google/gemini-2.0-flash-001
# OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001
# Development only: set to false to use mock insights instead of the callable
EXPO_PUBLIC_USE_CLOUD_AI=

# Launch readiness
EXPO_PUBLIC_SENTRY_DSN=
# Google Sign-In (Firebase Authentication — Web client ID required)
# See docs/GOOGLE_SIGN_IN.md — requires development / EAS builds (not Expo Go).
# Do not use expo-auth-session for Google (deprecated by Expo).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Optional: reversed iOS client ID. Auto-derived from EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID when omitted.
# Example: 123-abc.apps.googleusercontent.com → com.googleusercontent.apps.123-abc
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Sign in with Apple — Cloud Functions secrets only (never EXPO_PUBLIC_*).
# Configure via: firebase functions:secrets:set APPLE_TEAM_ID | APPLE_KEY_ID | APPLE_PRIVATE_KEY
# APPLE_CLIENT_ID defaults to com.scoutx.app (iOS bundle identifier).
# See docs/APPLE_SIGN_IN.md

# Deep linking / universal links (Firebase email verification & password reset)
# Prefer your Firebase Hosting domain until you own a branded host:
# EXPO_PUBLIC_APP_LINK_HOST=<project-id>.web.app
# If omitted, the app falls back to <EXPO_PUBLIC_FIREBASE_PROJECT_ID>.web.app
EXPO_PUBLIC_APP_LINK_HOST=
# See docs/DEEP_LINKING.md — deploy: firebase deploy --only hosting

# Firebase App Check (development builds / EAS builds — not available in Expo Go)
EXPO_PUBLIC_APP_CHECK_ENABLED=true
# Expo Go (`npm start`) uses a local guest session by default (Trading_App-style),
# because this project may not have Firebase Authentication enabled yet.
# After enabling Authentication → Anonymous in Firebase Console, set:
# EXPO_PUBLIC_FORCE_FIREBASE_AUTH=true
# EXPO_PUBLIC_FORCE_FIREBASE_AUTH=

# Local demo / mock data (never enable in production builds)
# EXPO_PUBLIC_USE_MOCK_DATA=true
# EXPO_PUBLIC_MOCK_DEMO_PASSWORD=

# Use debug providers in non-production builds (default). Set true to force debug in release builds.
EXPO_PUBLIC_APP_CHECK_USE_DEBUG=
# Register debug tokens in Firebase Console → App Check → Manage debug tokens
EXPO_PUBLIC_APP_CHECK_ANDROID_DEBUG_TOKEN=
EXPO_PUBLIC_APP_CHECK_IOS_DEBUG_TOKEN=
EXPO_PUBLIC_APP_CHECK_WEB_DEBUG_TOKEN=
# Web production provider (reCAPTCHA v3 site key)
EXPO_PUBLIC_APP_CHECK_RECAPTCHA_SITE_KEY=

# Store listing metadata lives in store/listing.json
# EAS submit credentials: configure eas.json submit.production section

# Dev server (optional — npm start auto-writes .env.local with LAN IP for Expo Go)
# EXPO_DEV_SERVER_PORT=8081

# Expo / EAS CLI (local only — add to .env, never commit)
# Option 1: npm run expo:login (interactive, in your terminal)
# Option 2: Access token from https://expo.dev/settings/access-tokens
# EXPO_TOKEN=your_token_here
# Note: EXPO_TOKEN is disabled only for npm run start:expo-go:tunnel (ngrok).
# NODE_TLS_REJECT_UNAUTHORIZED=0

# RevenueCat public iOS SDK key (safe to ship; entitlements are decided server-side by the webhook).
# Use the Test Store key (test_...) for development only; production builds refuse it and need the appl_... key.
# Entitlement: pitchproven. App Store products: PitchProven_Monthly, PitchProven_Yearly (Test Store: monthly, yearly),
# in the current offering as $rc_monthly / $rc_annual.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
