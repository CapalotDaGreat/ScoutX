rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /profiles/{userId}/videos/{videoId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && (
          (fileName == 'video.mp4'
            && request.resource.contentType.matches('video/.*')
            && request.resource.size < 100 * 1024 * 1024)
          || (fileName == 'thumb.jpg'
            && request.resource.contentType.matches('image/.*')
            && request.resource.size < 5 * 1024 * 1024)
        );
      allow delete: if isOwner(userId);
    }

    // Full match videos are written only by server promotion after ffprobe validation.
    match /profiles/{userId}/matchFootage/{jobId}/video.mp4 {
      allow read: if isOwner(userId);
      allow create, update: if false;
      allow delete: if isOwner(userId);
    }

    match /profiles/{userId}/matchFootage/{jobId}/frames/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && fileName.matches('frame_[0-9]+\\.jpg')
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 2 * 1024 * 1024;
      allow delete: if isOwner(userId);
    }

    // Optional short evidence clips, cut by the server only when the player asked for them.
    match /profiles/{userId}/matchFootage/{jobId}/clips/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if false;
      allow delete: if isOwner(userId);
    }

    // Rendered reels are written by the render function only.
    match /profiles/{userId}/reelExports/{exportId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Avatar and cover photos. Public display uses tokenized download URLs.
    match /profiles/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && fileName.matches('(avatar|cover)_[0-9]+\\.jpg')
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isOwner(userId);
    }

    // Personal data export archives, built by Cloud Functions and deleted after 7 days.
    match /exports/{userId}/{exportId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Large uploads go to server-authorized GCS resumable sessions; clients never touch quarantine.
    match /quarantine/{allPaths=**} {
      allow read, write: if false;
    }

    // GPS movement is processed on device and never uploaded. Legacy point files from older
    // builds may only be deleted by their owner (the server purge uses the Admin SDK).
    match /gpsSessions/{userId}/{sessionId}/{fileName} {
      allow read, create, update: if false;
      allow delete: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
