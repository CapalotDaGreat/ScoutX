rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /profiles/{userId}/videos/{videoId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && (
          (fileName == 'video.mp4'
            && request.resource.contentType.matches('video/.*')
            && request.resource.size < 100 * 1024 * 1024)
          || (fileName == 'thumb.jpg'
            && request.resource.contentType.matches('image/.*')
            && request.resource.size < 5 * 1024 * 1024)
        );
      allow delete: if isOwner(userId);
    }

    match /profiles/{userId}/matchFootage/{jobId}/video.mp4 {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.contentType.matches('video/.*')
        && request.resource.size < 4 * 1024 * 1024 * 1024;
      allow delete: if isOwner(userId);
    }

    match /profiles/{userId}/matchFootage/{jobId}/frames/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && fileName.matches('frame_[0-9]+\\.jpg')
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 2 * 1024 * 1024;
      allow delete: if isOwner(userId);
    }

    // Avatar and cover photos. Public display uses tokenized download URLs.
    match /profiles/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && fileName.matches('(avatar|cover)_[0-9]+\\.jpg')
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isOwner(userId);
    }

    // GPS tracks are location data: owner-only, JSON, bounded size.
    match /gpsSessions/{userId}/{sessionId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && fileName == 'points.json'
        && request.resource.contentType == 'application/json'
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
